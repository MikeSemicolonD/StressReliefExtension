{
  "manifest_version": 3,
  "name": "Screen Shake Stress Reliever",
  "author": "Michael Frye",
  "description": "Adds physics to HTML elements in the current tab for fun.",
  "version": "1.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "Toggle Physics (Right-click for Settings)",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "screen-shake-stress-reliever@michaelfrye",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["defaults.js", "lib.js", "matter.min.js", "content.js"],
      "css": ["styles.css"]
    }
  ],
  "options_page": "settings.html"
}